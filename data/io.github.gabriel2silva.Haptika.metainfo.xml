<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gabriel2silva.Haptika</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Haptika</name>
  <summary>Test game controllers</summary>

  <description>
    <p>
      Gamepad testing application for Linux. Quickly and
      interactively test buttons, analog sticks, triggers, touchpads,
      motion sensors, vibration, and speakers on virtually any controller.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Battery level and charging status display</li>
      <li>Bluetooth vs USB connection detection</li>
      <li>DualShock 3 pressure-sensitive button readout</li>
      <li>DualShock 4, DualSense, and DualSense Edge hardware info and authenticity checks</li>
      <li>DualSense speaker testing via PipeWire</li>
      <li>Motion sensor (accelerometer and gyroscope) visualization</li>
      <li>Touchpad finger tracking for DualShock 4 and DualSense</li>
      <li>Support for both SDL3 and evdev backends with one-click switching</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.gabriel2silva.Haptika.desktop</launchable>

  <branding>
    <color type="primary" scheme_preference="light">#cedff2</color>
    <color type="primary" scheme_preference="dark">#1d4372</color>
  </branding>


  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>gamepad</control>
  </supports>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

