{
    "app-id": "io.github.gabriel2silva.Haptika",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "haptika",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=all",
        "--filesystem=/sys:ro",
        "--filesystem=/run/udev:ro",
        "--socket=pulseaudio",
        "--filesystem=xdg-run/pipewire-0:ro"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake",
        "/share/man",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "libevdev",
            "buildsystem": "meson",
            "config-opts": [
                "-Dtests=disabled",
                "-Ddocumentation=disabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://freedesktop.org/software/libevdev/libevdev-1.13.6.tar.xz",
                    "sha256": "73f215eccbd8233f414737ac06bca2687e67c44b97d2d7576091aa9718551110"
                }
            ]
        },
        {
            "name": "sdl3",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DSDL_TESTS=OFF",
                "-DSDL_EXAMPLES=OFF",
                "-DSDL_INSTALL_TESTS=OFF",
                "-DSDL_WAYLAND=ON",
                "-DSDL_X11=ON",
                "-DSDL_HIDAPI=ON",
                "-DSDL_HIDAPI_LIBUSB=OFF",
                "-DSDL_PIPEWIRE=ON",
                "-DSDL_PULSEAUDIO=ON"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libsdl-org/SDL/releases/download/release-3.4.4/SDL3-3.4.4.tar.gz",
                    "sha256": "ee712dbe6a89bb140bbfc2ce72358fb5ee5cc2240abeabd54855012db30b3864"
                }
            ]
        },
        {
            "name": "haptika",
            "buildsystem": "meson",
            "post-install": [
                "install -Dm0644 LICENSE -t $FLATPAK_DEST/share/licenses/$FLATPAK_ID/haptika"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/Gabriel2Silva/Haptika/archive/refs/tags/v1.0.0.tar.gz",
                    "sha256": "9c3e2189f7d7c41f82ca554b11ed4d55bd3098370d5f0498ab72bda914996467"
                }
            ]
        }
    ]
}
